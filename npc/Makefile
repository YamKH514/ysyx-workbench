TOPNAME = ysyxSoCFull
NXDC_FILES = constr/top.nxdc
INC_PATH ?= $(NPC_HOME)/include
V_INC_PATH ?= $(NPC_HOME)/vsrc
UART_INC_PATH ?= $(YSYXSOC_HOME)/perip/uart16550/rtl
SPI_INC_PATH ?= $(YSYXSOC_HOME)/perip/spi/rtl

VERILATOR = verilator
VERILATOR_COVERAGE = verilator_coverage
VERILATOR_FLAGS += --autoflush --timescale "1ns/1ns" --no-timing --cc --trace -j 0 --top-module $(TOPNAME)
VERILATOR_FLAGS += $(addprefix -I, $(V_INC_PATH))
VERILATOR_FLAGS += $(addprefix -I, $(UART_INC_PATH))
VERILATOR_FLAGS += $(addprefix -I, $(SPI_INC_PATH))

BUILD_DIR = build
OBJ_DIR = $(BUILD_DIR)/obj_dir
BIN = $(BUILD_DIR)/$(TOPNAME)

default: $(BIN)

$(shell mkdir -p $(BUILD_DIR))

# constraint file
SRC_AUTO_BIND = $(abspath $(BUILD_DIR)/auto_bind.cpp)
$(SRC_AUTO_BIND): $(NXDC_FILES)
	python3 $(NVBOARD_HOME)/scripts/auto_pin_bind.py $^ $@

# project source
VSRCS += $(YSYXSOC_HOME)/build/ysyxSoCFull.v
VSRCS += $(shell find $(abspath ./vsrc) -name "*.v" ! -name "top.v")
VSRCS += $(shell find $(abspath $(YSYXSOC_HOME)/perip) -name "*.v")
CSRCS += $(shell find $(abspath ./csrc) -name "*.c" -or -name "*.cc" -or -name "*.cpp")
CSRCS += $(SRC_AUTO_BIND)

# rules for NVBoard
include $(NVBOARD_HOME)/scripts/nvboard.mk

# Include variables and rules generated by menuconfig
-include $(NPC_HOME)/include/config/auto.conf
-include $(NPC_HOME)/include/config/auto.conf.cmd

remove_quote = $(patsubst "%",%,$(1))

CXXFLAGS += -fsanitize=address
LDFLAGS  += -fsanitize=address

# Extract compiler and options from menuconfig
CFLAGS_TRACE += -DITRACE_COND=$(if $(CONFIG_ITRACE_COND),$(call remove_quote,$(CONFIG_ITRACE_COND)),true)
CXXFLAGS  += $(CFLAGS_TRACE)

# Include rules for menuconfig
include $(NPC_HOME)/scripts/config.mk

# Include all filelist.mk to merge file lists
FILELIST_MK = $(shell find -L ./csrc -name "filelist.mk")
include $(FILELIST_MK)

# rules for verilator
INCFLAGS += $(addprefix -I, $(INC_PATH))
CXXFLAGS += $(INCFLAGS) -DTOP_NAME="\"V$(TOPNAME)\""

LDFLAGS += -lreadline -lncurses

include $(NPC_HOME)/tools/difftest.mk

override ARGS ?= --log=$(BUILD_DIR)/npc-log.txt
override ARGS += $(ARGS_DIFF)

# am img
IMG ?=

$(BIN): $(VSRCS) $(CSRCS) $(SRC_AUTO_BIND) $(NVBOARD_ARCHIVE)
	@echo "--Build--"
	@rm -rf $(OBJ_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) --build \
		--top-module $(TOPNAME) $^ \
		$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))

all:
	@echo "Write this Makefile by your self."

nvb: $(BIN)
	@echo "--RUN--"
	@$^

sim: $(VSRCS) $(CSRCS)
	$(call git_commit, "sim RTL") # DO NOT REMOVE THIS LINE!!!
	@echo
	@echo "-- BUILD ----------------"
	@rm -rf $(OBJ_DIR)
	$(VERILATOR) $(VERILATOR_FLAGS) --build \
		--top-module $(TOPNAME) $^ \
		$(addprefix -CFLAGS , $(CXXFLAGS)) $(addprefix -LDFLAGS , $(LDFLAGS)) \
		--Mdir $(OBJ_DIR) --exe -o $(abspath $(BIN))

	@echo
	@echo "-- RUN ---------------------"
	@rm -rf logs
	@mkdir -p logs
	$(BIN) $(ARGS) $(IMG) +trace

run: sim

clean:
	rm -rf $(BUILD_DIR) logs obj_dir

include ../Makefile

.PHONY: all clean sim nvb
